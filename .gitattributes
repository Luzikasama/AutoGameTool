# 统一换行符处理，避免 Windows / Linux 协作时出现"整文件改动"的噪声 diff
* text=auto

# Windows 脚本保持 CRLF（Windows PowerShell 5.1 与 makensis 都按 CRLF 习惯处理）
*.ps1     text eol=crlf
*.nsi     text eol=crlf
*.nsh     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 源码与文档使用 LF
*.py      text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf

# 二进制文件不做换行符转换
*.exe     binary
*.dll     binary
*.pyd     binary
*.ico     binary
*.icns    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.zip     binary
*.7z      binary
*.pdf     binary
