# ============================================================
#  AutoTool .gitignore
# ============================================================

# ---------- Python ----------
engine/.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- PyInstaller 构建产物 ----------
# 注意：AutoTool.spec 与 build.log 由 PyInstaller 生成，
# 内部会写入构建机的绝对路径（含用户名），因此不要入库。
engine/build/
engine/dist/
engine/build.log
engine/AutoTool.spec
*.spec.bak

# ---------- 前端 ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/src-tauri/target/
frontend/src-tauri/gen/
*.local
# 源码运行时引擎从这里读界面（tools/test_ui_appearance.py 会临时复制一份并清理）
engine/frontend_dist/

# ---------- 打包 / 安装 / 测试的临时文件 ----------
.tmp/
.smoketmp/
.smoketmp*/
*.tmp

# ---------- 构建 / 验证脚本产生的中间输出（下划线前缀的临时文件）----------
_*.txt
_*.log
.workbuddy/

# ---------- 日志 ----------
*.log

# ---------- 本机协作约定（agent 指令文件，只放本地，不进公开仓库）----------
# DSH 的 agent-instructions 会自动加载这些文件；公开仓库只保留项目信息（README）。
AGENTS.local.md
CLAUDE.local.md

# ---------- 发行产物 ----------
# 二进制产物体积大（v0.6.0 实测 exe / 安装包各约 71 MB），放进 git 会永久留在历史里，
# 因此统一不入库，改为在 GitHub Releases 中发布（见 README「打包与发布」）。
/AutoTool.exe
/AutoTool-Setup.exe
# v0.8.2 起发行版是文件夹形态（exe + _internal\），同样不入库
/AutoTool-app/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
ehthumbs.db
