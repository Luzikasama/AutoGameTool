# ============================================================
#  AutoGameTool .gitignore
# ============================================================

# ---------- Python ----------
engine/.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- PyInstaller 构建产物 ----------
# 注意：AutoGameTool.spec 与 build.log 由 PyInstaller 生成，
# 内部会写入构建机的绝对路径（含用户名），因此不要入库。
engine/build/
engine/dist/
engine/build.log
engine/AutoGameTool.spec
*.spec.bak

# ---------- 前端 ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/src-tauri/target/
*.local

# ---------- 打包 / 安装 / 测试的临时文件 ----------
.tmp/
.smoketmp/
.smoketmp*/
tools/nsis/
tools/_nsis_unpack/
*.tmp

# ---------- 构建 / 验证脚本产生的中间输出（下划线前缀的临时文件）----------
_*.txt
_*.log
.workbuddy/

# ---------- 日志 ----------
*.log

# ---------- 发行产物 ----------
# 二进制产物体积大（exe / 安装包各约 68 MB），放进 git 会永久留在历史里，
# 因此统一不入库，改为在 GitHub Releases 中发布（见 README「打包与发布」）。
/AutoGameTool.exe
/AutoGameTool-Setup.exe

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
ehthumbs.db
